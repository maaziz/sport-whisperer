{
  "version": 1,
  "sdk_version": "0.26.3",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "sports-stats-whisperer",
      "version": "0.2.0",
      "title": "sports-stats-whisperer"
    },
    "tools": [
      {
        "name": "list_sports",
        "title": "List sports",
        "description": "List every sport covered by this app, with its team names and how many players are available.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_players",
        "title": "List players",
        "description": "List players for a sport, optionally filtered by team. Returns id, name, team and role/position.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sport": {
              "type": "string",
              "enum": [
                "cricket",
                "nfl",
                "soccer",
                "basketball",
                "mlb",
                "nhl"
              ],
              "description": "Sport key, e.g. cricket, nfl, soccer, basketball, mlb, nhl."
            },
            "team": {
              "type": "string",
              "minLength": 1,
              "description": "Optional exact team name to filter by."
            }
          },
          "required": [
            "sport"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "search_players",
        "title": "Search players",
        "description": "Search all sports for players by name, team, or role/position. Returns matching players with their sport.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Free-text search over player name, team and role."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_player_stats",
        "title": "Get player stats",
        "description": "Get the full stat sheet for one player by id (e.g. virat-kohli) or by name. Searches every sport.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 1,
              "description": "Player id or player name."
            }
          },
          "required": [
            "query"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "compare_players",
        "title": "Compare players",
        "description": "Compare the stat sheets of two or more players from the same sport, side by side.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sport": {
              "type": "string",
              "enum": [
                "cricket",
                "nfl",
                "soccer",
                "basketball",
                "mlb",
                "nhl"
              ],
              "description": "Sport the players belong to."
            },
            "players": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "maxItems": 5,
              "description": "Two to five player ids or names from that sport."
            }
          },
          "required": [
            "sport",
            "players"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_player_stats",
        "title": "Update player stats",
        "description": "Update a player's stats, current team, portrait or display name. Stat fields are merged into the player's existing stat sheet, so you can send only the fields that changed. The update is stored as an override and immediately replaces the built-in values everywhere in the app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "player": {
              "type": "string",
              "minLength": 1,
              "description": "Player id (e.g. virat-kohli) or full player name."
            },
            "sport": {
              "type": "string",
              "enum": [
                "cricket",
                "nfl",
                "soccer",
                "basketball",
                "mlb",
                "nhl"
              ],
              "description": "Optional sport hint, useful when the same name exists in several sports."
            },
            "stats": {
              "type": "object",
              "additionalProperties": {},
              "description": "Stat fields to change, using the same field names the read tools return."
            },
            "team": {
              "type": "string",
              "minLength": 1,
              "description": "New current team or club."
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "description": "Corrected display name."
            },
            "image": {
              "type": "string",
              "format": "uri",
              "description": "Portrait image URL (Wikimedia Commons, face-forward crop)."
            },
            "source": {
              "type": "string",
              "minLength": 1,
              "description": "Where the new numbers came from, e.g. 'Baseball-Reference, 2025 season end'."
            }
          },
          "required": [
            "player"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_player_updates",
        "title": "List player updates",
        "description": "List the stat updates that have been applied on top of the built-in data, newest first. Use it to see what has already been refreshed and when.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sport": {
              "type": "string",
              "enum": [
                "cricket",
                "nfl",
                "soccer",
                "basketball",
                "mlb",
                "nhl"
              ],
              "description": "Limit to one sport."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maximum rows to return."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "revert_player_update",
        "title": "Revert player update",
        "description": "Remove a previously applied update for one player, restoring the built-in stat sheet, team and portrait.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "sport": {
              "type": "string",
              "enum": [
                "cricket",
                "nfl",
                "soccer",
                "basketball",
                "mlb",
                "nhl"
              ],
              "description": "Sport the player belongs to."
            },
            "player_id": {
              "type": "string",
              "minLength": 1,
              "description": "Player id, e.g. virat-kohli."
            }
          },
          "required": [
            "sport",
            "player_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
